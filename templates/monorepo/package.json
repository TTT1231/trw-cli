    "type": "module",
    "scripts": {
        "postinstall": "pnpm -r run --if-present stub",
        "clean": "node scripts/clean.mjs",
        "typecheck": "tsx scripts/run-affected.ts typecheck",
        "typecheck:scripts": "tsc --project tsconfig.json",
